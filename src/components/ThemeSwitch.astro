---
import { Sun, Moon } from 'lucide-react';
import type { Language } from '../config/locale';
interface Props { lang: Language }
const en = Astro.props.lang === 'en';
---
<button type="button" class="icon-button theme-switch" data-theme-switch
  aria-label={en ? 'Dark mode' : 'Dunkler Modus'} aria-pressed="false" hidden>
  <Sun className="theme-sun" size={19} aria-hidden="true"/>
  <Moon className="theme-moon" size={19} aria-hidden="true"/>
</button>
<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-switch]');
  const system = matchMedia('(prefers-color-scheme: dark)');
  const read = () => { try { return localStorage.getItem('bb-theme'); } catch { return null; } };
  let preference = read();
  function update() {
    const dark = preference === 'dark' || (preference !== 'light' && system.matches);
    root.dataset.theme = dark ? 'dark' : 'light';
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#171815' : '#f4f0e6');
    button?.setAttribute('aria-pressed', String(dark));
  }
  update();
  if (button) {
    button.hidden = false;
    button.addEventListener('click', () => {
      preference = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('bb-theme', preference); } catch { /* Storage is optional. */ }
      update();
    });
  }
  system.addEventListener('change', update);
  window.addEventListener('storage', event => {
    if (event.key === 'bb-theme' || event.key === null) { preference = read(); update(); }
  });
</script>
