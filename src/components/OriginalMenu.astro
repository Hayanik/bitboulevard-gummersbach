---
import { Image } from 'astro:assets';
import { Expand, X, ArrowUpRight } from 'lucide-react';
import first from '../assets/menu/original-4.jpg';
import second from '../assets/menu/original-2.jpg';
import third from '../assets/menu/original-3.jpg';
import fourth from '../assets/menu/original-1.jpg';
import type { Language } from '../config/locale';
const { lang } = Astro.props as {lang: Language};
const en = lang === 'en';
const cards = [
 { image: first, title: en ? 'Starters & salads' : 'Vorspeisen & Salate' },
 { image: second, title: en ? 'Greek specialities' : 'Griechische Spezialitäten' },
 { image: third, title: 'Pizza · 20 & 24 cm' },
 { image: fourth, title: en ? 'Meat dishes & extras' : 'Fleischgerichte & Extras' },
];
---
<section class="original-menu" aria-labelledby="original-title">
  <div class="original-heading"><div><p class="eyebrow">{en ? 'The original, page by page' : 'Das Original, Seite für Seite'}</p><h2 id="original-title">{en ? 'A LOOK AT THE CARD.' : 'EIN BLICK IN DIE KARTE.'}</h2></div><a class="text-link" href="#gerichte">{en ? 'Find a dish' : 'Gericht finden'} <ArrowUpRight size={18} aria-hidden="true"/></a></div>
  <div class="original-grid">{cards.map((card, i) => <a class="original-card" href={card.image.src} data-original-card aria-label={(en ? 'Enlarge original menu: ' : 'Originalkarte vergrößern: ') + card.title}>
    <div class="original-image"><Image src={card.image} alt={(en ? 'Original printed menu: ' : 'Gedruckte Originalkarte: ') + card.title} widths={[320,480,720]} sizes="(max-width: 540px) 45vw, (max-width: 900px) 40vw, 22vw" format="webp" quality={85} loading="lazy"/><span class="original-expand"><Expand size={19} aria-hidden="true"/></span></div>
    <div class="original-caption"><span>0{i + 1}</span><h3>{card.title}</h3><ArrowUpRight size={17} aria-hidden="true"/></div>
  </a>)}</div>
  <p class="original-source">{en ? 'The four published restaurant menu pages, retrieved on 7 November 2026. Tap to enlarge. All dishes are also available as searchable text below.' : 'Die vier veröffentlichten Speisekartenseiten des Restaurants, abgerufen am 7. November 2026. Antippen zum Vergrößern. Alle Gerichte stehen darunter auch als durchsuchbarer Text.'}</p>
</section>
<dialog class="original-dialog" aria-labelledby="original-dialog-title">
  <div class="original-dialog-bar"><h2 id="original-dialog-title">{en ? 'Original menu' : 'Originalkarte'}</h2><form method="dialog"><button class="icon-button" aria-label={en ? 'Close original menu' : 'Originalkarte schließen'}><X aria-hidden="true"/></button></form></div>
  <p>{en ? 'Scroll to read the full page. Open the image for additional zoom.' : 'Scrolle, um die ganze Seite zu lesen. Öffne das Bild für weitere Vergrößerung.'} <a class="text-link" data-original-open href="#">{en ? 'Open image' : 'Bild öffnen'} ↗</a></p>
  <img data-original-full alt="" width="1284" height="1790"/>
</dialog>
<script>
 const dialog = document.querySelector<HTMLDialogElement>('.original-dialog');
 const img = dialog?.querySelector<HTMLImageElement>('[data-original-full]');
 const title = dialog?.querySelector<HTMLElement>('#original-dialog-title');
 const full = dialog?.querySelector<HTMLAnchorElement>('[data-original-open]');
 if (dialog && img && title && full) {
  document.querySelectorAll<HTMLAnchorElement>('[data-original-card]').forEach(link => link.addEventListener('click', event => {
   if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
   event.preventDefault();
   img.src = link.href;
   img.alt = link.querySelector('img')?.alt ?? '';
   title.textContent = link.querySelector('h3')?.textContent ?? '';
   full.href = link.href;
   dialog.showModal();
   dialog.scrollTop = 0;
  }));
  dialog.addEventListener('click', event => {
   const rect = dialog.getBoundingClientRect();
   if(event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
  });
  dialog.addEventListener('close', () => { img.removeAttribute('src'); });
 }
</script>
