---
import { ArrowUpRight, ArrowUp } from 'lucide-react';
import { business, maps } from '../config/business';
import { language, navigation, routes } from '../config/locale';
const lang = language(Astro.url.pathname);
const en = lang === 'en';
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-kicker"><span><i></i> BRÜCKENSTRASSE 08 / 51643</span><a class="icon-button top-link" href="#seitenanfang" aria-label={en ? 'Back to top' : 'Zum Seitenanfang'}><ArrowUp aria-hidden="true"/></a></div>
    <div class="footer-display"><h2>{en ? 'SEE YOU' : 'BIS GLEICH'}<br/><em>{en ? 'AT BIT.' : 'IM BIT.'}</em></h2><a class="button" href={routes.contact[lang]+'#tisch'}>{en ? 'Book a table' : 'Tisch anfragen'} <ArrowUpRight size={18} aria-hidden="true"/></a></div>
    <div class="footer-grid">
      <div><h3>{en ? 'Find us' : 'Vorbeikommen'}</h3><address>{business.street}<br/>{business.postalCode} {business.city}</address><a href={routes.directions[lang]}>{en ? 'Directions' : 'Anfahrt'}</a><a href={maps}>Google Maps ↗</a></div>
      <div><h3>{en ? 'Get in touch' : 'Kontakt'}</h3><a href={business.tel}>{business.phone}</a><a href={`mailto:${business.email}`}>{business.email}</a></div>
      <nav aria-label={en ? 'More pages' : 'Weitere Seiten'}><h3>{en ? 'Explore' : 'Entdecken'}</h3>{navigation(lang).map(({href,label}) => <a href={href}>{label}</a>)}<a href={routes.kitchen[lang]}>{en ? 'From the kitchen' : 'Aus der Küche'}</a></nav>
      <div><h3>{en ? 'Order' : 'Bestellen'}</h3><a href={business.order}>{en ? 'Direct ordering' : 'Direkt bestellen'} ↗</a><a href={business.lieferando}>Lieferando ↗</a><a href={business.android}>{en ? 'Android app' : 'Android-App'} ↗</a><a href={business.ios}>{en ? 'iOS app' : 'iOS-App'} ↗</a></div>
    </div>
    <div class="footer-legal"><span>© Bit Boulevard · Gummersbach</span><div><a href={routes.legal[lang]}>{en ? 'Legal notice' : 'Impressum'}</a><a href={routes.privacy[lang]}>{en ? 'Privacy' : 'Datenschutz'}</a><a href={routes.accessibility[lang]}>{en ? 'Accessibility' : 'Barrierefreiheit'}</a><button type="button" class="footer-privacy-button" data-privacy-open hidden>{en ? 'Privacy settings' : 'Datenschutzeinstellungen'}</button></div></div>
  </div>
</footer>
