---
import { ArrowUpRight, ChevronLeft, ChevronRight, Expand, X, ZoomIn } from 'lucide-react';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../data/photos';
import { language, routes } from '../config/locale';
const lang = language(Astro.url.pathname);
const en = lang === 'en';
const captions = en ? ['Warm lighting, timber and a place to sit together.', 'The skewer is a classic on our menu, including a country-style pork version.', 'On our menu, bifteki comes filled with sheep’s cheese.', 'We serve gyros with fries, tzatziki and onions.'] : ['Warmes Licht, Holz und ein Tisch zum Zusammensitzen.', 'Der Spieß ist ein Klassiker auf der Karte, etwa als Bauern-Souvlaki vom Schweinenacken.', 'Auf unserer Karte ist Bifteki mit Schafskäse gefüllt.', 'Auf der Karte gibt’s Gyros mit Pommes, Tzatziki und Zwiebeln.'];
const gallery = await Promise.all([photos.room, photos.souvlaki, photos.bifteki, photos.gyros].map(async (photo, i) => ({
  ...photo,
  title: en ? ['Light in the tavern', 'Grilled souvlaki', 'Grilled bifteki', 'Gyros by candlelight'][i] : photo.title,
  alt: en ? ['Illustrative image of a warmly lit tavern', 'Illustrative image of souvlaki and lemon', 'Illustrative image of grilled bifteki', 'Illustrative image of gyros by candlelight'][i] : photo.alt,
  full: (await getImage({ src: photo.src, format: 'webp', width: Math.min(1536, photo.src.width) })).src,
})));
---
<Base title={en ? "Gallery | Bit Boulevard Gummersbach" : "Galerie | Bit Boulevard Gummersbach"} description={en ? "A visual study of Greek food and a tavern atmosphere." : "Eine Bilderstrecke rund um griechische Küche und gemütliche Gaststubenatmosphäre."}>
  <PageHead label={en ? "An evening in pictures" : "Ein Abend in Bildern"} title={en ? "AFTER" : "WENN ES"} accent={en ? "DARK." : "ABEND WIRD."} description={en ? "Greek food and tavern lighting in a series of AI illustrations." : "Griechische Küche und Gaststubenlicht in einer Serie aus KI-Bildmotiven."}/>
  <section class="light content-section">
    <div class="shell gallery-intro">
      <div><p class="eyebrow">01 / {en ? 'The visual story' : 'Die Bilderstrecke'}</p><h2>{en ? 'From the room to the grill.' : 'Von der Gaststube zum Grill.'}</h2></div>
      <p>{en ? 'Four illustrations explore the light of a tavern and three dishes from the menu. Select any image for a closer look. In the viewer, use the arrow keys to browse and Escape to close.' : 'Vier Bildmotive zeigen die Stimmung einer Gaststube und drei Gerichte von der Karte. Wähle ein Bild für die Großansicht. Dort kannst du mit den Pfeiltasten blättern und mit Escape schließen.'}</p>
    </div>
    <div class="shell gallery-grid">
      {gallery.map((photo,i) => <figure>
        <a class="image-frame" href={photo.full} data-gallery data-title={photo.title} aria-label={en ? `Open ${photo.title}` : `${photo.title} öffnen`}>
          <Photo photo={photo}/><span class="gallery-expand" aria-hidden="true"><Expand size={20}/></span>
        </a>
        <figcaption><small>0{i+1} / {en ? 'AI illustration' : 'KI-Bildmotiv'}</small><span>{photo.title}</span><p>{captions[i]}</p></figcaption>
      </figure>)}
    </div>
  </section>
  <section class="light content-section">
    <div class="shell editorial-callout">
      <div><p class="eyebrow">02 / {en ? 'On the menu' : 'Auf der Karte'}</p><h2>{en ? 'See what’s served.' : 'Was auf den Tisch kommt.'}</h2>
        <p>{en ? 'The gallery uses AI illustrations. The menu lists the dishes you can ask about or order, and our directions page shows where to find us.' : 'Die Galerie zeigt KI-Illustrationen. In der Speisekarte findest du die Gerichte, nach denen du fragen oder die du bestellen kannst. Adresse und Route stehen auf der Anfahrtsseite.'}</p>
      </div>
      <div class="actions"><a class="button button-dark" href={routes.menu[lang]}>{en ? 'Browse the menu' : 'Speisekarte ansehen'}</a><a class="text-link" href={routes.directions[lang]}>{en ? 'Directions' : 'Anfahrt'}</a></div>
    </div>
  </section>
  <section class="bb-room content-section">
    <div class="shell">
      <div class="gallery-intro"><div><p class="eyebrow">03 / {en ? 'Beyond the frame' : 'Hinter den Bildern'}</p><h2>{en ? 'Follow the details.' : 'Die Details entdecken.'}</h2></div><p>{en ? 'Two threads run through the gallery: the atmosphere of a tavern and the dishes from the grill. You can follow either into the rest of the site.' : 'Zwei Themen ziehen sich durch die Galerie: das Licht einer Gaststube und die Gerichte vom Grill. Hier kannst du beide weiterverfolgen.'}</p></div>
      <div class="editorial-links">
        <a href={routes.about[lang]}><small>01</small><div><strong>{en ? 'A seat at the table' : 'Ein Platz am Tisch'}</strong><p>{en ? 'Read about the restaurant and plan a visit with your group.' : 'Lies mehr über das Lokal und plane deinen Besuch mit deiner Runde.'}</p></div><ArrowUpRight aria-hidden="true"/></a>
        <a href={routes.kitchen[lang]}><small>02</small><div><strong>{en ? 'Skewers and specialities' : 'Spieße und Spezialitäten'}</strong><p>{en ? 'Find out what comes with the grill dishes and what else is on the menu.' : 'Erfahre, was zu den Grillgerichten gehört und was sonst auf der Karte steht.'}</p></div><ArrowUpRight aria-hidden="true"/></a>
      </div>
    </div>
  </section>
  <dialog class="lightbox" aria-labelledby="lightbox-title">
    <div class="lightbox-bar"><h2 id="lightbox-title"></h2>
      <button class="icon-button" type="button" data-zoom aria-label={en ? "Zoom in" : "Bild vergrößern"} data-zoom-in={en ? "Zoom in" : "Bild vergrößern"} data-zoom-out={en ? "Zoom out" : "Bild verkleinern"} aria-pressed="false"><ZoomIn aria-hidden="true"/></button>
      <button class="icon-button" type="button" data-dismiss aria-label={en ? "Close gallery" : "Galerie schließen"} autofocus><X aria-hidden="true"/></button>
    </div>
    <div class="lightbox-stage"><img alt="" width="1200" height="800"/></div>
    <div class="lightbox-bar lightbox-nav">
      <button class="icon-button" type="button" data-step="-1" aria-label={en ? "Previous image" : "Vorheriges Bild"}><ChevronLeft aria-hidden="true"/></button>
      <span data-count aria-live="polite"></span>
      <button class="icon-button" type="button" data-step="1" aria-label={en ? "Next image" : "Nächstes Bild"}><ChevronRight aria-hidden="true"/></button>
    </div>
  </dialog>
</Base>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery]')];
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const image = dialog?.querySelector('img');
  const title = dialog?.querySelector('#lightbox-title');
  const count = dialog?.querySelector('[data-count]');
  const stage = dialog?.querySelector<HTMLElement>('.lightbox-stage');
  const zoom = dialog?.querySelector<HTMLButtonElement>('[data-zoom]');
  if (dialog && image && title && count && stage && zoom && links.length) {
    let index = 0;
    let opener: HTMLAnchorElement;
    function setZoom(active: boolean) {
      stage!.classList.toggle('zoomed', active);
      zoom!.setAttribute('aria-pressed', String(active));
      zoom!.setAttribute('aria-label', (active ? zoom!.dataset.zoomOut : zoom!.dataset.zoomIn) ?? '');
      stage!.scrollTo(0, 0);
    }
    function show(next: number) {
      index = (next + links.length) % links.length;
      const link = links[index];
      image!.src = link.href;
      image!.alt = link.querySelector('img')?.alt ?? '';
      title!.textContent = link.dataset.title ?? '';
      count!.textContent = `${index + 1} / ${links.length}`;
      setZoom(false);
    }
    links.forEach((link, position) => link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      opener = link;
      show(position);
      dialog.showModal();
    }));
    dialog.querySelector('[data-dismiss]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button =>
      button.addEventListener('click', () => show(index + Number(button.dataset.step))));
    dialog.addEventListener('keydown', event => {
      if (stage.classList.contains('zoomed') || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      show(index + (event.key === 'ArrowLeft' ? -1 : 1));
    });
    zoom.addEventListener('click', () => setZoom(!stage.classList.contains('zoomed')));
  }
</script>
