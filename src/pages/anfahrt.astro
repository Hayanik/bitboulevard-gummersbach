---
import { ArrowUpRight, MapPin, Phone } from 'lucide-react';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import MapBox from '../components/MapBox.astro';
import Hours from '../components/Hours.astro';
import { business, directions } from '../config/business';
import { language, routes } from '../config/locale';
const lang = language(Astro.url.pathname);
const en = lang === 'en';
---
<Base title={en ? 'Directions & Opening Hours | Bit Boulevard' : 'Anfahrt & Küchenzeiten | Bit Boulevard'}
  description={en ? 'Find Bit Boulevard at Brückenstraße 8 in Gummersbach. Address, directions and kitchen hours.' : 'Bit Boulevard an der Brückenstraße 8 in Gummersbach. Adresse, Routenplanung und Küchenzeiten.'}>
  <PageHead label={en ? 'Your visit / Gummersbach' : 'Dein Besuch / Gummersbach'} title={en ? 'FIND US.' : 'ANFAHRT.'} description="Brückenstraße 8, 51643 Gummersbach"/>
  <section class="light content-section">
    <div class="shell bb-visit-grid">
      <div><p class="eyebrow">{en ? 'Address' : 'Adresse'}</p>
        <address><MapPin size={19} aria-hidden="true"/><span>{business.name}<br/>{business.street}<br/>{business.postalCode} {business.city}</span></address>
        <div class="actions"><a class="button button-dark" href={directions}>{en ? 'Get directions' : 'Route planen'} <ArrowUpRight size={17} aria-hidden="true"/></a></div>
        <Hours lang={lang}/>
      </div>
      <MapBox lang={lang}/>
    </div>
  </section>
  <section class="light content-section">
    <div class="shell editorial-callout"><div><p class="eyebrow">{en ? 'Before you set off' : 'Vor deinem Besuch'}</p><h2>{en ? 'Questions about access?' : 'Fragen zum Zugang?'}</h2>
      <p>{en ? 'If you need information about entering the restaurant or arranging a table to suit your needs, call us before your visit.' : 'Wenn du wissen möchtest, wie du ins Lokal kommst oder welcher Tisch für dich passt, ruf uns vor deinem Besuch an.'}</p></div>
      <div class="actions"><a class="button button-dark" href={business.tel}><Phone size={17} aria-hidden="true"/> {business.phone}</a><a class="text-link" href={routes.contact[lang]+'#tisch'}>{en ? 'Request a table' : 'Tisch anfragen'}</a></div>
    </div>
  </section>
</Base>
